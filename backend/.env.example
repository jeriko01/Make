# =====================================================================
# Make — backend environment (FastAPI)
# Copy to `.env` and fill in real values. NEVER commit .env.
# =====================================================================

# --- Supabase (server-side) ---
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# SERVICE ROLE key — SERVER ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# ANON key — used by the backend only to verify user JWTs via Supabase Auth.
SUPABASE_ANON_KEY=

# Storage bucket for uploaded images (created by supabase/migrations/0004_storage.sql)
SUPABASE_STORAGE_BUCKET=media

# --- Admin authorization ---
# Comma-separated list of emails allowed to perform admin writes.
# Must match a user you created in the Supabase dashboard.
ADMIN_EMAILS=you@example.com

# --- CORS ---
# Comma-separated list of allowed frontend origins (no trailing slash).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Contact form rate limiting ---
CONTACT_RATE_LIMIT_MAX=5          # max submissions ...
CONTACT_RATE_LIMIT_WINDOW=3600    # ... per this many seconds, per IP

# --- Uploads ---
MAX_UPLOAD_MB=5

# --- App ---
ENVIRONMENT=development
