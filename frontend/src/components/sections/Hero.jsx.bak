import { Link } from 'react-router-dom'
import { ArrowRight, ExternalLink, Globe, Smartphone, Server, Database } from 'lucide-react'
import { useSiteData } from '../../context/SiteDataContext'
import Reveal from '../common/Reveal'

/** Polished initials-based portrait placeholder ready for replacement */
function PortraitPlaceholder({ initials = 'MK' }) {
  return (
    <div
      className="relative flex h-full w-full flex-col items-center justify-end bg-gradient-to-b from-[#161d15] via-[#141714] to-[#000000] p-8 overflow-hidden select-none"
      role="img"
      aria-label="Make portrait"
    >
      {/* Background grid */}
      <div className="absolute inset-0 grid-bg-dark opacity-60 pointer-events-none" />

      {/* Decorative neon green glow behind initials */}
      <div className="absolute -top-10 left-1/2 -translate-x-1/2 h-44 w-44 rounded-full bg-[#39A751]/15 blur-2xl pointer-events-none" />

      {/* Center Initials */}
      <div className="relative z-10 my-auto text-center">
        <span className="font-display text-8xl font-black tracking-tighter text-white/10 sm:text-9xl">
          {initials}
        </span>
        <div className="mt-2 inline-flex items-center gap-1.5 rounded-full border border-[#39A751]/30 bg-[#1e2b1a]/80 px-3 py-1">
          <span className="h-1.5 w-1.5 rounded-full bg-[#52fe7d] animate-pulse" />
          <span className="text-[11px] font-semibold uppercase tracking-wider text-[#d2d7dc]">
            Photo Placeholder
          </span>
        </div>
      </div>

      {/* Helper text */}
      <p className="relative z-10 text-center text-xs font-medium text-[#8a949e]">
        Replace with real portrait via <code className="text-[#52fe7d] font-mono">avatar_url</code>
      </p>

      {/* Bottom neon accent rule */}
      <div className="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#39A751] to-transparent" />
    </div>
  )
}

/** Credibility / Capability strip items */
const CAPABILITIES = [
  {
    icon: Globe,
    title: 'Web',
    detail: 'React · TypeScript · Tailwind CSS',
    desc: 'Responsive, accessible web applications',
  },
  {
    icon: Smartphone,
    title: 'Mobile',
    detail: 'React Native · Flutter · Native',
    desc: 'Cross-platform iOS & Android apps',
  },
  {
    icon: Server,
    title: 'APIs',
    detail: 'Python · FastAPI · REST',
    desc: 'Clean, dependable backend services',
  },
  {
    icon: Database,
    title: 'Data',
    detail: 'Supabase · PostgreSQL',
    desc: 'Relational data modeling & auth',
  },
]

export default function Hero() {
  const { data } = useSiteData()
  const hero = data?.hero || {}
  const profile = data?.profile || {}

  return (
    <section
      id="home"
      aria-label="Hero"
      className="relative flex min-h-screen flex-col justify-between overflow-hidden bg-[#0e0e0e] pt-24 lg:pt-32"
    >
      {/* Background ambient lighting */}
      <div className="pointer-events-none absolute inset-0 grid-bg-dark opacity-70" />
      <div className="pointer-events-none absolute -left-48 top-10 h-96 w-96 rounded-full bg-[#39A751]/10 blur-[100px]" />
      <div className="pointer-events-none absolute -right-32 top-32 h-80 w-80 rounded-full bg-[#52fe7d]/5 blur-[90px]" />

      {/* Main Split Hero */}
      <div className="container-page relative z-10 my-auto py-12 lg:py-16">
        <div className="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">

          {/* ── Left Column: Concise Copy + Side-by-side CTAs ── */}
          <div className="max-w-2xl lg:max-w-none">

            {/* Eyebrow badge */}
            <Reveal>
              <div className="inline-flex items-center gap-2 rounded-full border border-[#39A751]/30 bg-[#1e2b1a]/90 px-3.5 py-1.5 text-xs font-bold tracking-widest text-[#52fe7d]">
                <span className="h-2 w-2 rounded-full bg-[#39A751] animate-pulse" />
                <span>{hero.eyebrow || 'SENIOR WEB & MOBILE APPLICATION ENGINEER'}</span>
              </div>
            </Reveal>

            {/* Main Headline */}
            <Reveal delay={80}>
              <h1 className="mt-6 font-display text-4xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-6xl xl:text-7xl">
                Web and mobile<br />
                products,{' '}
                <span className="relative inline-block text-white">
                  <span className="relative z-10">built to work.</span>
                  {/* Subtle neon-green highlight underline */}
                  <span className="absolute bottom-1 left-0 right-0 h-1 bg-[#39A751] rounded-full" />
                </span>
              </h1>
            </Reveal>

            {/* Exact Paragraph copy */}
            <Reveal delay={160}>
              <p className="mt-6 max-w-xl text-lg leading-relaxed text-[#d2d7dc] sm:text-xl">
                {hero.description ||
                  'I turn product ideas into clear, dependable applications—from the first screen to the API and data behind it.'}
              </p>
            </Reveal>

            {/* Side-by-side CTAs: "Explore my work" and "Let's collaborate" */}
            <Reveal delay={240}>
              <div className="mt-8 flex flex-wrap items-center gap-4">
                <Link
                  to={hero.primary_cta_href || '/projects'}
                  className="btn-lime gap-2 px-6 py-3.5 text-base shadow-lg shadow-[#39A751]/25 hover:shadow-[#39A751]/40"
                >
                  <span>{hero.primary_cta_label || 'Explore my work'}</span>
                  <ExternalLink className="h-4 w-4" />
                </Link>

                <Link
                  to={hero.secondary_cta_href || '/support'}
                  className="btn-outline gap-2 px-6 py-3.5 text-base"
                >
                  <span>{hero.secondary_cta_label || "Let's collaborate"}</span>
                  <ArrowRight className="h-4 w-4" />
                </Link>
              </div>
            </Reveal>

            {/* Micro assurance note */}
            <Reveal delay={300}>
              <p className="mt-6 text-xs text-[#8a949e]">
                Full-stack development · Clean architecture · Available for contract & remote roles
              </p>
            </Reveal>
          </div>

          {/* ── Right Column: Portrait in Make visual frame ── */}
          <Reveal delay={140} className="mx-auto w-full max-w-[380px] lg:mx-0 lg:ml-auto">
            <div className="relative">
              {/* Make Signature Animated Frame */}
              <div className="make-frame animate-float">
                <div className="make-frame-inner aspect-[4/5] relative">
                  {profile.avatar_url ? (
                    <img
                      src={profile.avatar_url}
                      alt={`${profile.full_name || 'Make'} portrait`}
                      className="h-full w-full object-cover"
                      loading="eager"
                    />
                  ) : (
                    <PortraitPlaceholder initials={profile.initials || 'MK'} />
                  )}

                  {/* Overlaid status badge */}
                  <div className="absolute top-4 left-4 z-20 flex items-center gap-2 rounded-full border border-[#1e261d] bg-[#141714]/90 px-3 py-1 backdrop-blur-md">
                    <span className="h-2 w-2 rounded-full bg-[#39A751] animate-pulse" />
                    <span className="text-[11px] font-semibold text-white">Available Worldwide</span>
                  </div>
                </div>
              </div>

              {/* Bottom tag pill */}
              <div className="absolute -bottom-4 left-1/2 -translate-x-1/2 z-20 whitespace-nowrap rounded-xl border border-[#1e261d] bg-[#161d15] px-4 py-2 shadow-2xl">
                <p className="text-xs font-bold uppercase tracking-wider text-[#d2d7dc]">
                  Senior Full-Stack Engineer
                </p>
              </div>
            </div>
          </Reveal>
        </div>
      </div>

      {/* ── Credibility / Capability strip directly below the hero ── */}
      <div id="capability-strip" className="relative z-10 border-t border-[#1e261d] bg-[#141714]">
        <div className="container-page py-6">
          <div className="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
            {CAPABILITIES.map((cap) => {
              const IconComp = cap.icon
              return (
                <div
                  key={cap.title}
                  className="flex items-start gap-3.5 rounded-xl border border-[#1e261d]/80 bg-[#0e0e0e]/50 p-3.5 transition hover:border-[#39A751]/30 hover:bg-[#0e0e0e]"
                >
                  <span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#1e2b1a] border border-[#39A751]/40 text-[#52fe7d]">
                    <IconComp className="h-4 w-4" />
                  </span>
                  <div>
                    <h3 className="font-display text-sm font-bold text-white">
                      {cap.title}
                    </h3>
                    <p className="text-xs font-semibold text-[#52fe7d]">
                      {cap.detail}
                    </p>
                    <p className="mt-0.5 text-[11px] text-[#8a949e]">
                      {cap.desc}
                    </p>
                  </div>
                </div>
              )
            })}
          </div>
        </div>
      </div>
    </section>
  )
}
