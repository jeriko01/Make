# =====================================================================
# Make — frontend environment (Vite)
# Copy to `.env` and fill in. Only VITE_* vars are exposed to the browser.
# NEVER put the Supabase SERVICE ROLE key here — anon key only.
# =====================================================================

# Base URL of the FastAPI backend.
# In dev, leave as "/api" to use Vite's proxy (see vite.config.js).
# In production, set to your deployed API origin, e.g. https://api.yourdomain.com
VITE_API_BASE_URL=/api

# Supabase (public anon key — safe to expose). Used ONLY for admin login.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
